generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DeliveryStatus {
  PENDING
  RETRYING
  DELIVERED
  FAILED
}

enum DeliveryAttemptOutcome {
  SUCCESS
  FAILURE
}

model Project {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  endpoints  Endpoint[]
  eventTypes EventType[]
  events     Event[]
}

model Endpoint {
  id        String   @id @default(cuid())
  projectId String
  name      String
  url       String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project       Project                @relation(fields: [projectId], references: [id])
  subscriptions EndpointSubscription[]
  deliveries    Delivery[]

  @@index([projectId])
}

model EventType {
  id        String   @id @default(cuid())
  projectId String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project       Project                @relation(fields: [projectId], references: [id])
  subscriptions EndpointSubscription[]
  events        Event[]

  @@unique([projectId, name])
}

model EndpointSubscription {
  endpointId  String
  eventTypeId String
  createdAt   DateTime @default(now())

  endpoint  Endpoint  @relation(fields: [endpointId], references: [id])
  eventType EventType @relation(fields: [eventTypeId], references: [id])

  @@id([endpointId, eventTypeId])
}

model Event {
  id          String   @id @default(cuid())
  projectId   String
  eventTypeId String
  payload     Json
  createdAt   DateTime @default(now())

  project    Project    @relation(fields: [projectId], references: [id])
  eventType  EventType  @relation(fields: [eventTypeId], references: [id])
  deliveries Delivery[]

  @@index([projectId, createdAt])
}

model Delivery {
  id            String         @id @default(cuid())
  eventId       String
  endpointId    String
  status        DeliveryStatus @default(PENDING)
  nextAttemptAt DateTime?
  deliveredAt   DateTime?
  failedAt      DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  event    Event             @relation(fields: [eventId], references: [id])
  endpoint Endpoint          @relation(fields: [endpointId], references: [id])
  attempts DeliveryAttempt[]

  @@unique([eventId, endpointId])
  @@index([endpointId, status, createdAt])
}

model DeliveryAttempt {
  id            String                  @id @default(cuid())
  deliveryId    String
  attemptNumber Int
  startedAt     DateTime                @default(now())
  completedAt   DateTime?
  outcome       DeliveryAttemptOutcome?
  httpStatus    Int?
  errorType     String?
  errorMessage  String?
  durationMs    Int?
  requestUrl    String

  delivery Delivery @relation(fields: [deliveryId], references: [id])

  @@unique([deliveryId, attemptNumber])
}
